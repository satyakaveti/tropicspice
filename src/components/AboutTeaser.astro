---
---
<section class="relative bg-white py-16 md:py-24 overflow-hidden border-t border-gray-50">
  <div class="max-w-container mx-auto px-4">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text content (Left 6 Cols) -->
      <div class="lg:col-span-6 space-y-6">
        <span class="text-brown text-sm font-bold tracking-wider uppercase inline-block">
          // Who We Are
        </span>
        <h2 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          Pioneering Indian Spice <span class="text-primary font-serif font-medium">Export</span> Globally
        </h2>
        <p class="text-muted leading-relaxed">
          Established in 2010, TropicSpice Global brings decades of combined expertise in sourcing, processing, and distributing high-grade spices. We bridge the gap between traditional Indian farming and the demanding international food industry.
        </p>
        <p class="text-muted leading-relaxed">
          Under strict expert supervision, our products are formulated to preserve native freshness, essential oils, and health benefits, ensuring a consistent premium experience.
        </p>

        <!-- Dynamic Value Bullet Points -->
        <div class="grid md:grid-cols-2 gap-4 pt-4">
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
              <i class="fa-solid fa-leaf"></i>
            </span>
            <div>
              <h4 class="font-bold text-gray-900 text-sm">Sustainably Sourced</h4>
              <p class="text-xs text-muted">Directly from regional farms</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
              <i class="fa-solid fa-clipboard-check"></i>
            </span>
            <div>
              <h4 class="font-bold text-gray-900 text-sm">Certified Quality</h4>
              <p class="text-xs text-muted">ISO, APEDA & Spice Board standards</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
              <i class="fa-solid fa-award"></i>
            </span>
            <div>
              <h4 class="font-bold text-gray-900 text-sm">Rich Heritage</h4>
              <p class="text-xs text-muted">Aroma & taste preserved natively</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
              <i class="fa-solid fa-earth-americas"></i>
            </span>
            <div>
              <h4 class="font-bold text-gray-900 text-sm">Global Distribution</h4>
              <p class="text-xs text-muted">Efficient cargo export operations</p>
            </div>
          </div>
        </div>

        <div class="pt-6">
          <a href="/about" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary/10 text-primary font-bold hover:bg-primary hover:text-white transition">
            Learn More About Us <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>
      </div>

      <!-- Overlapping Composition (Right 6 Cols) -->
      <div class="lg:col-span-6 relative flex items-center justify-center">
        <div class="relative w-[280px] h-[340px] md:w-[380px] md:h-[450px] shrink-0">
          <!-- Background accent shape (dotted grid placeholder/deco) -->
          <div class="absolute -top-6 -right-6 w-32 h-32 bg-[radial-gradient(#21550a_1px,transparent_1px)] [background-size:16px_16px] opacity-30"></div>

          <!-- Main Image -->
          <div class="absolute inset-0 rounded-[30px] overflow-hidden shadow-2xl z-10 border-[6px] border-white">
            <img src="/images/abt-img.png" alt="TropicSpice Global spices selection" class="w-full h-full object-cover" />
          </div>

          <!-- Offset Image -->
          <div class="absolute -bottom-8 -left-8 w-[50%] h-[50%] rounded-2xl overflow-hidden shadow-2xl z-20 border-[4px] border-white">
            <img src="/images/whole-haldi.jpg" alt="Whole Turmeric" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
