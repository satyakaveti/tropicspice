---
export interface Props {
  image: string;
  title: string;
}
const { image, title } = Astro.props;
---
<section class="relative bg-cover bg-center py-[120px] md:py-[160px] flex items-center justify-center overflow-hidden" style={`background-image:url('${image}')`}>
  <!-- Dark overlay gradient for contrast -->
  <div class="absolute inset-0 bg-black/45 backdrop-blur-[2px] z-0"></div>
  
  <div class="relative z-10 text-center px-4">
    <h1 class="text-4xl md:text-6xl font-bold text-white font-sans tracking-tight drop-shadow-md">
      {title}
    </h1>
    <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded"></div>
  </div>
</section>
