---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerBanner from '../../components/InnerBanner.astro';

const spices = [
  { name: 'Turmeric / Haldi Powder', img: '/images/haldi-powder.jpg' },
  { name: 'Whole Turmeric / Haldi', img: '/images/whole-haldi.jpg' },
  { name: 'Cumin / Jira', img: '/images/cumin.jpg' },
  { name: 'Indian Red Chili / Lal Mirchi Powder', img: '/images/indian-red-chili-powder.jpg' },
  { name: 'Whole Indian Red Chili / Lal Mirchi', img: '/images/whole-indian-red-chili.jpg' },
  { name: 'Green Cardamom / Ilaychi', img: '/images/green-cardamom.jpg' },
  { name: 'Coriander / Dhana Powder', img: '/images/coriander-powder.jpg' },
  { name: 'Tej Patta', img: '/images/tej-patta.jpg' },
  { name: 'Black Pepper', img: '/images/black-pepper.jpg' },
  { name: 'Carom / Ajwain', img: '/images/carom.jpg' },
  { name: 'Cinnamon / Taj', img: '/images/cinnamon.jpg' },
  { name: 'Cloves / Laung', img: '/images/cloves.jpg' },
  { name: 'Fennel / Saunf', img: '/images/fennel.jpg' },
  { name: 'Ginger / Adrak', img: '/images/ginger.jpg' },
  { name: 'Fenugreek / Methi', img: '/images/methi.jpg' },
  { name: 'Mustard Seeds / Rai', img: '/images/mustard-seeds.jpg' },
  { name: 'Nutmeg / Jaiphal', img: '/images/nutmeg.jpg' },
  { name: 'Star Anise / Chakra Phool', img: '/images/star-anise.jpg' },
];
---
<BaseLayout title="Spices | TROPICSPICE GLOBAL">
  <InnerBanner image="/images/product-banner.jpg" title="Our Spices Catalog" />

  <section class="bg-white py-16 md:py-24">
    <div class="max-w-container mx-auto px-4">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-brown text-sm font-bold tracking-wider uppercase inline-block mb-2">
          // Pure Indian Spices
        </span>
        <h2 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tight">
          Export Quality <span class="text-primary font-serif font-bold">Spices</span>
        </h2>
        <p class="text-muted mt-4">
          Each batch is processed using modern machinery under clean hygienic environments to maintain raw aroma, essential oils, and health value parameters.
        </p>
      </div>

      <!-- Spices Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {spices.map((s) => (
          <div class="group bg-white rounded-3xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
            <!-- Product image with hover zoom -->
            <div class="w-full aspect-[4/3] overflow-hidden bg-gray-50">
              <img src={s.img} alt={s.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </div>
            <!-- Card Details -->
            <div class="p-6 text-center space-y-2">
              <span class="text-[10px] uppercase tracking-widest font-bold text-brown">Premium Grade Export</span>
              <h3 class="text-lg font-bold text-primary transition-colors duration-200">
                {s.name}
              </h3>
              <p class="text-xs text-muted">100% Pure, Untouched Sourcing</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
